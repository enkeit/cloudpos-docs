---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } =
	Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menu = menuResult.data;
/** "/docs/ecom/user-guide/checkout" → "/docs/ecom": the header tab a page belongs to. */
const sectionOf = (path: string) => path.split("/").slice(0, 3).join("/");

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<link rel="icon" type="image/png" href="/brand/favicon-64.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600&display=swap" rel="stylesheet" />
		<script is:inline>
			// Light by default; dark only when the visitor chose it (applied before first paint).
			try {
				if (localStorage.getItem("cloudpos-theme") === "dark") document.documentElement.setAttribute("data-theme", "dark");
			} catch {}
		</script>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header class="topbar">
			<a class="brand" href="/" aria-label="CloudPOS Documentation home">
				<span class="logo"><img src="/brand/cloudpos-mark-256.png" alt="" width="32" height="32" /></span>
				<span class="words">
					<span class="name"><span class="cloud">CLOUD</span><span class="pos">POS</span></span>
					<span class="sub">Documentation</span>
				</span>
			</a>
			<nav class="topnav" aria-label="Sections">
				{
					menu?.items.map((item) => (
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							aria-current={sectionOf(Astro.url.pathname) === sectionOf(item.url) ? "true" : undefined}
						>
							{item.label}
						</a>
					))
				}
			</nav>
			<div class="top-right">
				<button id="searchOpen" class="search-trigger" type="button" aria-haspopup="dialog" aria-label="Search the docs">
					<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
					<span class="label">Search the docs…</span>
					<kbd>Ctrl K</kbd>
				</button>
				<a class="ask-ai" href="https://ai.cloudposai.com" target="_blank" rel="noopener" title="Ask the CloudPOS AI"><span>AI</span><b class="label">Ask</b></a>
				<button id="themeToggle" class="icon-btn" type="button" aria-label="Switch to dark mode" title="Switch to dark mode">
					<svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
					<svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" /></svg>
				</button>
			</div>
		</header>

		<dialog id="searchDialog" class="search-dialog" aria-label="Search the docs">
			<div class="search-panel">
				<div class="search-head">
					<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
					<LiveSearch placeholder="Search the docs…" collections={["docs"]} routeMap={{ docs: "/docs/:path" }} limit={12} />
					<button id="searchClose" class="search-esc" type="button" aria-label="Close search">Esc</button>
				</div>
				<p class="search-hint">Try “split payment”, “day close” or “ZATCA”.</p>
			</div>
		</dialog>

		<script is:inline>
			(() => {
				const root = document.documentElement;
				const themeButton = document.getElementById("themeToggle");
				const sync = () => {
					const label = root.getAttribute("data-theme") === "dark" ? "Switch to light mode" : "Switch to dark mode";
					themeButton.title = label;
					themeButton.setAttribute("aria-label", label);
				};
				themeButton.addEventListener("click", () => {
					const dark = root.getAttribute("data-theme") !== "dark";
					if (dark) root.setAttribute("data-theme", "dark");
					else root.removeAttribute("data-theme");
					try { localStorage.setItem("cloudpos-theme", dark ? "dark" : "light"); } catch {}
					sync();
				});
				sync();

				// Search opens in a modal over a blurred page: button, Ctrl/⌘ K or "/".
				const dialog = document.getElementById("searchDialog");
				const input = () => dialog.querySelector("input");
				const open = () => {
					if (dialog.open) return;
					dialog.showModal();
					root.classList.add("search-open");
					// Focus at once so keys typed right after Ctrl/⌘ K land in the box.
					input()?.focus();
				};
				const close = () => dialog.open && dialog.close();
				dialog.addEventListener("close", () => root.classList.remove("search-open"));
				document.getElementById("searchOpen").addEventListener("click", open);
				document.getElementById("searchClose").addEventListener("click", close);
				dialog.addEventListener("click", (e) => { if (e.target === dialog) close(); });
				document.addEventListener("keydown", (e) => {
					const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName) || e.target.isContentEditable;
					if ((e.key === "k" || e.key === "K") && (e.ctrlKey || e.metaKey)) { e.preventDefault(); open(); }
					else if (e.key === "/" && !typing && !dialog.open) { e.preventDefault(); open(); }
				});
				if (/Mac|iPhone|iPad/.test(navigator.platform)) document.querySelector(".search-trigger kbd").textContent = "⌘ K";

				// Tidy each result: real /docs/a/b address (slugs use "--" for "/"), the
				// section it belongs to as a label, and no snippet that only repeats the title.
				const SECTIONS = { "pos-app": "POS App", api: "API Reference", "admin-panel": "Admin Panel", ecom: "Online Store" };
				new MutationObserver(() => {
					for (const a of dialog.querySelectorAll('a[href^="/docs/"]')) {
						const href = a.getAttribute("href");
						if (href.includes("--")) a.setAttribute("href", href.replace(/--/g, "/"));
						const section = SECTIONS[a.getAttribute("href").split("/")[2]];
						const label = a.querySelector(".emdash-live-search-result-collection");
						if (label && section && label.textContent !== section) label.textContent = section;
						const title = a.querySelector(".emdash-live-search-result-title")?.textContent.trim().toLowerCase();
						const snippet = a.querySelector(".emdash-live-search-result-snippet");
						if (snippet?.textContent && snippet.textContent.trim().toLowerCase() === title) snippet.textContent = "";
					}
				}).observe(dialog, { subtree: true, childList: true, attributes: true, attributeFilter: ["href"] });
			})();
		</script>

		<main>
			<slot />
		</main>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
